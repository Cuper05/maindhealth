# Mac local (sin contraseña): postgresql://TU_USUARIO@localhost:5432/maindhealth
DATABASE_URL=postgresql://user:password@localhost:5432/maindhealth

SESSION_SECRET=change_me_to_a_long_random_string_32chars

ADMIN_EMAIL=admin@maindhealth.local
ADMIN_PASSWORD=admin123

NEXT_PUBLIC_APP_URL=http://localhost:3003

# Videollamada Daily.co (Fase 3)
# Si VIDEO_API_KEY está configurada, las citas teleconsulta crean sala automáticamente.
VIDEO_PROVIDER=daily
VIDEO_API_KEY=
DAILY_DOMAIN=maindhealth

# Pagos Stripe (portal + kiosco estación)
# Checkout: /portal/pagos y /estacion/paciente → «Pagar con tarjeta»
# Webhook: POST /api/payments/webhook (checkout.session.completed + async_payment_succeeded)
# Diagnóstico: GET /api/payments/status
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Ingesta de lecturas de hardware (Fase 4)
DEVICE_INGEST_API_KEY=

# Motor clínico IA de la estación (opcional).
# Sin esta llave la estación usa el motor de reglas clínicas integrado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Código de estación física (referencia de pago EST-001-...)
STATION_CODE=EST-001

# Nayax VPOS Touch (fase hardware; el cobro principal del kiosco es Stripe)
NAYAX_ENABLED=false

# Twilio (alertas urgentes teleconsulta)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# TWILIO_MESSAGING_SERVICE_SID=MG...   # preferido para SMS
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_ENABLED=true         # solo si el sandbox/sender ya funciona
# TELECONSULTA_ALERT_PHONES=+524491523007
# APP_BASE_URL=https://health.maindsteel.com.mx

# Correo (receta PDF al paciente desde el kiosco)
# Crear API key en https://resend.com → RESEND_API_KEY
# EMAIL_FROM debe ser un dominio verificado en Resend
RESEND_API_KEY=
EMAIL_FROM=MaindHealth <noreply@tu-dominio.com>

